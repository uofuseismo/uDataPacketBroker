#.rst
# FinduDataPacketBroker
# ---------------------
#
# Finds the UUSS data packet broker library.
#
# Imported Targets
# ^^^^^^^^^^^^^^^^
#
# ``uDataPacketBroker_FOUND``
#   True indicates uDataPacketBroker was found.
# ``uDataPacketBroker::uDataPacketBroker``
#   The data packet broker library, if found.
include(CMakeFindDependencyMacro)

find_dependency(TBB)

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
